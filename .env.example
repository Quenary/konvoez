# Secrets (required)
MASTER_KEY=
JWT_SECRET=

# Tokens
ACCESS_TTL= # Defaults to 15, Access token TTL in minutes
REFRESH_TTL= # Defaults to 10080, Refresh token TTL in minutes

# Cookies
COOKIE_SECURE= # Defaults to false, Set to true when running behind HTTPS
COOKIE_SAME_SITE= # Defaults to lax, options: lax, strict, none
COOKIE_DOMAIN= # Optional, e.g. .example.com

# Mediasoup (required for voice calls)
# Public IPv4 or domain name of your server
# Used by WebRTC clients to reach Mediasoup
# Default value is only for development purposes
MEDIASOUP_ANNOUNCED_IP= # Defaults to 127.0.0.1
# RTC Port range for Mediasoup worker
# Must match ports forwarded in router & docker-compose
MEDIASOUP_MIN_PORT= # Defaults to 40000
MEDIASOUP_MAX_PORT= # Defaults to 40100

# Push notifications
# Used in VAPID contact details
# Default value is only for development purposes
VAPID_EMAIL= # Defaults to konvoez@invalid.email
# Optional directory for persisting VAPID keys on disk.
# Defaults to the shared app data folder next to sqlite/files.
VAPID_FILE_DIR= # Defaults to /konvoez_data

#region DB
# For now, only sqlite is supported, but the option is kept for future use.
DB_ENGINE= # Defaults to sqlite
DB_NAME= # Defaults to /konvoez_data/konvoez.sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
#endregion

#region Storage
# Supported engines: local, s3
OBJECT_STORAGE=local
LOCAL_OBJECT_STORAGE_PATH=/konvoez_data/files
# Setting or changing OBJECT_STORAGE_PREFIX points the app at new, empty containers.
# Existing avatars and attachments are not moved (re-upload avatars).
OBJECT_STORAGE_PREFIX=
# Optional ffmpeg binary for server-side video posters. Empty uses `ffmpeg` on PATH.
# A set but invalid path is not replaced with PATH. The image does not include ffmpeg.
FFMPEG_PATH=
# Temp upload directory. Defaults to <LOCAL_OBJECT_STORAGE_PATH>/.tmp
# (or .tmp-<prefix> when OBJECT_STORAGE_PREFIX is set).
UPLOAD_TMP_DIR=
# S3
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
#endregion

# Optional GitHub token for checking app updates (releases/latest).
# Without it, unauthenticated rate limit is 60 req/h per IP.
# Classic PAT needs no scopes for the public Quenary/konvoez repo.
GITHUB_TOKEN=

#region SMTP
# SMTP (password recovery emails). Leave SMTP_HOST empty to disable outbound mail.
SMTP_HOST=
SMTP_PORT=
# Encryption: TLS (implicit, default port 465), STARTTLS (default port 587),
# or any other/empty value for no encryption (default port 25).
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED= # Defaults to true, Set to false only for lab/self-signed SMTP certificates.
#endregion

#region Settings controlled via the UI.
# Environment variables take precedence and overwrite
# current database values on application startup.
ICE_SERVERS= # Defaults to several public servers
INVITE_ONLY_SIGN_UP= # Defaults to true, does not affect initial owner registration
PASSWORD_RECOVERY_CODE_TTL= # Defaults to 600000 (10 minutes), range 60000–3600000 ms
ATTACHMENTS_ENABLED= # Defaults to true
ATTACHMENTS_MAX_FILE_SIZE= # Defaults to 52428800 (50 MiB), range 1 MiB–1 GiB
ATTACHMENTS_MAX_FILES_PER_MESSAGE= # Defaults to 10
ATTACHMENTS_STRIP_IMAGE_METADATA= # Defaults to false
#endregion

# Backend port
# Be aware that default nginx is configured to proxy 80 to 3000
# Mainly used for development purposes
PORT=3000