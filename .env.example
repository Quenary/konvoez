# Server
PORT=3000

# Secrets (required)
MASTER_KEY=
JWT_SECRET=

# Auth & Tokens
ACCESS_TTL=15 # Access token TTL in minutes (default: 15)
REFRESH_TTL=10080 # Refresh token TTL in minutes (default: 10080 / 7 days)

# Cookies
COOKIE_SECURE=false # Set to true when running behind HTTPS
COOKIE_SAME_SITE=lax # lax, strict, or none (default: lax)
COOKIE_DOMAIN= # e.g. .example.com (optional)

# Media (required for voice calls)
# Public IPv4 or domain name of your server (used by WebRTC clients to reach Mediasoup):
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# RTC Port range for Mediasoup worker (must match ports forwarded in router & docker-compose)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# DB
# Supported engines are: sqlite, mysql, postgres
DB_ENGINE=sqlite
DB_NAME=/konvoez_data/konvoez.sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Storage
# Supported engines: local, s3
OBJECT_STORAGE=local
LOCAL_OBJECT_STORAGE_PATH=/konvoez_data/files

# Push notifications
# Used in VAPID contact details; defaults to konvoez@invalid.email if not set.
VAPID_EMAIL=konvoez@invalid.email
# Optional directory for persisting VAPID keys on disk.
# Defaults to the shared app data folder next to sqlite/files.
VAPID_FILE_DIR=/konvoez_data

# S3
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Optional GitHub token for checking app updates (releases/latest).
# Without it, unauthenticated rate limit is 60 req/h per IP.
# Classic PAT needs no scopes for the public Quenary/konvoez repo.
GITHUB_TOKEN=

# SMTP (password recovery emails). Leave SMTP_HOST empty to disable outbound mail.
SMTP_HOST=
SMTP_PORT=
# Encryption: TLS (implicit, default port 465), STARTTLS (default port 587),
# or any other/empty value for no encryption (default port 25).
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to false only for lab/self-signed SMTP certificates.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Settings controlled via the UI.
# Environment variables take precedence and overwrite
# current database values on application startup.
INVITE_ONLY_SIGN_UP= # defaults to true, does not affect initial owner registration
ICE_SERVERS= # defaults to several public servers
PASSWORD_RECOVERY_CODE_TTL= # defaults to 600000 (10 minutes), range 60000–3600000 ms

