# Secrets (required)
MASTER_KEY=
JWT_SECRET=

# Media (required)
MEDIASOUP_ANNOUNCED_IP=

# DB
# Supported engines are: sqlite, mysql, postgres
DB_ENGINE=sqlite
DB_NAME=konvoez.sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Storage
# Supported engines: local, s3
OBJECT_STORAGE=local
LOCAL_OBJECT_STORAGE_PATH=/konvoez/files

# S3
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_FORCE_PATH_STYLE=