{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "options": {
        "commands": [
          {
            "command": "webpack-cli build",
            "forwardAllArgs": false
          }
        ],
        "outputPath": "dist/apps/backend",
        "main": "apps/backend/src/main.ts",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/backend"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "migration-create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register ../../node_modules/.bin/mikro-orm migration:create",
        "cwd": "apps/backend"
      }
    },
    "migration-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r tsconfig-paths/register ../../node_modules/.bin/mikro-orm migration:up",
        "cwd": "apps/backend"
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/package.json",
        "{workspaceRoot}/dist/apps/backend/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/backend/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false,
        "inspect": false,
        "debounce": 1000
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
