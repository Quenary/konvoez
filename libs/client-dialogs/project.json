{
  "name": "client-dialogs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client-dialogs/src",
  "projectType": "library",
  "tags": ["scope:client", "type:feature"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["ui-kit:generate-tokens"],
      "options": {
        "command": "vitest run",
        "cwd": "libs/client-dialogs"
      }
    },
    "eslint:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "libs/client-dialogs"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"{projectRoot}\""
      }
    },
    "format:write": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"{projectRoot}\""
      }
    }
  }
}
