{
  "name": "client-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client-shell/src",
  "projectType": "library",
  "tags": ["scope:client", "type:util"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
