{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist/**"],
      "cache": true
    },
    "start:dev": {
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    }
  },
  "analytics": true,
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    }
  ],
  "release": {
    "projects": ["backend", "frontend", "shared"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}",
      "requireSemver": true,
      "checkAllBranchesWhen": false
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "specifierSource": "conventional-commits",
      "versionActions": "./tools/release/root-package-version-actions.cjs",
      "updateDependents": "never",
      "logUnchangedProjects": false
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": { "semverBump": "minor", "changelog": { "title": "Features" } },
        "fix": { "semverBump": "patch", "changelog": { "title": "Bug Fixes" } },
        "perf": {
          "semverBump": "patch",
          "changelog": { "title": "Performance Improvements" }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": { "title": "Code Refactoring" }
        },
        "docs": { "semverBump": "none", "changelog": false },
        "style": { "semverBump": "patch", "changelog": { "title": "Styles" } },
        "test": { "semverBump": "none", "changelog": false },
        "build": { "semverBump": "none", "changelog": false },
        "ci": { "semverBump": "none", "changelog": false },
        "chore": { "semverBump": "none", "changelog": false },
        "revert": { "semverBump": "patch", "changelog": { "title": "Reverts" } }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "projectChangelogs": false
    },
    "git": {
      "commitMessage": "chore(release): {version} [skip ci]"
    }
  }
}
