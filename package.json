    "packageManager": {
      "name": "npm",
      "version": ">=10.9"
    }
  },
  "keywords": [
    "chat",
    "voice",
    "text",
    "discord",
    "teamspeak",
    "mumble",
    "self-hosted"
  ],
  "author": "Eugene Savin",
