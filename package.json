{
  "name": "konvoez",
  "version": "1.0.0",
  "description": "Self-hosted voice and text chat app",
  "scripts": {
    "turbo": "turbo",
    "build": "turbo build",
    "start": "turbo run //#s3 start:dev",
    "s3": "s3rver -a 192.168.0.8 -p 4568 -d ./s3-dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quenary/konvoez.git"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },
  "keywords": [
    "chat",
    "voice",
    "text",
    "discord",
    "teamspeak",
    "mumble",
    "self-hosted"
  ],
  "author": "Eugene Savin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Quenary/konvoez/issues"
  },
  "homepage": "https://github.com/Quenary/konvoez#readme",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "libs/common"
  ],
  "private": true,
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.5",
    "prettier": "^3.8.1",
    "s3rver": "^3.7.1",
    "semantic-release": "^25.0.3",
    "turbo": "^2.10.4",
    "typescript": "^5.9.0"
  }
}
