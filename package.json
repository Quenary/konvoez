{
  "name": "konvoez",
  "version": "1.14.0",
  "description": "Self-hosted voice and text chat app",
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "start:dev": "nx run-many -t serve --outputStyle=stream",
    "start:dev:sw": "nx run-many -t serve --projects=backend,frontend --configuration=development-sw --outputStyle=stream",
    "lint": "nx run-many -t eslint:lint",
    "fmt": "nx format:write --all",
    "test": "nx run-many -t test",
    "release": "node tools/release.mjs",
    "release:dry": "node tools/release.mjs --dry-run",
    "migration:create": "nx run backend:migration-create",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quenary/konvoez.git"
  },
  "engines": {
    "node": "^22.22.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.9"
    }
  },
  "keywords": [
    "chat",
    "voice",
    "text",
    "discord",
    "teamspeak",
    "mumble",
    "self-hosted"
  ],
  "author": "Eugene Savin",
  "license": "MIT",
